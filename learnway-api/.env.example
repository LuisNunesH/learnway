# ─── Neon PostgreSQL ─────────────────────────────────────────────
# Get this from https://neon.tech → your project → Connection Details.
# Use the JDBC form for Spring. Neon requires SSL.
# Example:
#   DATABASE_URL=jdbc:postgresql://ep-xxx-123456.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=jdbc:postgresql://<host>/neondb?sslmode=require
DATABASE_USERNAME=<neon-user>
DATABASE_PASSWORD=<neon-password>

# ─── JWT ─────────────────────────────────────────────────────────
# Base64-encoded 256-bit (or longer) secret. Generate one with:
#   openssl rand -base64 48
JWT_SECRET=<base64-secret>

# ─── Google Gemini (AI Studio) ───────────────────────────────────
# Get a free key at https://aistudio.google.com → "Get API Key".
GEMINI_API_KEY=<your-gemini-key>
GEMINI_MODEL=gemini-3.5-flash

# ─── CORS ────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:4200

# ─── Fuso horário ────────────────────────────────────────────────
# Recorte de "dia" para streak, calendário, heatmap e sessões de estudo.
# O padrão já é America/Sao_Paulo; só mude se o público não for do Brasil.
# APP_TIMEZONE=America/Sao_Paulo
