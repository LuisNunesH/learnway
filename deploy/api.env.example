# Variáveis da API na VM. Copie para `api.env` (sem .example) e preencha.
#
# Este arquivo fica SÓ na VM, em ~/learnway/api.env — nunca no git.
# Depois de criá-lo:  chmod 600 api.env
#
# Os valores são os mesmos do seu learnway-api/.env local.

# ─── Neon PostgreSQL ─────────────────────────────────────────────
DATABASE_URL=jdbc:postgresql://ep-xxx.neon.tech/neondb?sslmode=require
DATABASE_USERNAME=seu-usuario-neon
DATABASE_PASSWORD=sua-senha-neon

# ─── JWT ─────────────────────────────────────────────────────────
# Gere um novo com: openssl rand -base64 48
JWT_SECRET=seu-segredo-base64

# ─── IA ──────────────────────────────────────────────────────────
GEMINI_API_KEY=sua-chave-gemini
GROQ_API_KEY=sua-chave-groq

# ─── Frontend ────────────────────────────────────────────────────
# A origem exata do site publicado (sem barra no final). Se não bater,
# o navegador bloqueia todas as chamadas por CORS.
CORS_ALLOWED_ORIGINS=https://learnway.pages.dev
OAUTH_FRONTEND_REDIRECT=https://learnway.pages.dev/oauth/callback
OAUTH_FAILURE_REDIRECT=https://learnway.pages.dev/entrar?error=oauth

# ─── Login social (opcional) ─────────────────────────────────────
# Se não usar, deixe comentado: os defaults "unset" mantêm o boot funcionando.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# ─── Fuso horário ────────────────────────────────────────────────
# Recorte de "dia" para streak, calendário, heatmap e sessões de estudo.
# O padrão já é America/Sao_Paulo; só mude se o público não for do Brasil.
# APP_TIMEZONE=America/Sao_Paulo
